# Grafana Cloud OTLP export for the downstream collector.
# Copy to .env and fill in from your Grafana Cloud stack:
#   Grafana Cloud Portal -> your stack -> "OTLP" / "Configure"
#   (or Connections -> OpenTelemetry -> OTLP)

# OTLP gateway URL for your region, ending in /otlp (no trailing slash after it).
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp

# Numeric instance ID shown on the same OTLP page (this is the basic-auth username).
GRAFANA_CLOUD_INSTANCE_ID=123456

# Cloud Access Policy token with logs:write scope (this is the basic-auth password).
GRAFANA_CLOUD_API_TOKEN=glc_xxxxxxxxxxxxxxxxxxxxxxxx
