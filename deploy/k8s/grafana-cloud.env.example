# Grafana Cloud OTLP credentials for the downstream collector.
# Copy to grafana-cloud.env (gitignored) and fill in from your Grafana Cloud
# stack (Portal -> your stack -> "OTLP" / "Configure"). The kustomize
# secretGenerator in kustomization.yaml reads this file into the
# downstream-collector-secrets Secret at `kubectl apply -k` time.

# OTLP gateway URL for your region, ending in /otlp (no trailing slash after it).
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-central-0.grafana.net/otlp

# Numeric instance ID shown on the OTLP page (basic-auth username).
GRAFANA_CLOUD_INSTANCE_ID=123456

# Cloud Access Policy token with logs:write scope (basic-auth password).
GRAFANA_CLOUD_API_TOKEN=glc_REPLACE_ME
